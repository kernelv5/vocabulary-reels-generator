# Vocabulary Reels Generator - Environment Variables
# Copy this file to .env and customize

# TTS Configuration  
TTS_URL=http://host.docker.internal:8004/v1/audio/speech
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_SPEED=1.0

# Branding
CHANNEL_NAME=@YourChannel

# Server
API_HOST=0.0.0.0
API_PORT=5000
FLASK_ENV=production
