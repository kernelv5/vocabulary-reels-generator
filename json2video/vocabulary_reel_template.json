{
  "comment": "Instagram Vocabulary Reels Template - @WhiteEnglishVocabulary",
  "description": "Minimalist educational vocabulary reels with precise layout specifications",
  
  "resolution": "custom",
  "width": 1080,
  "height": 1920,
  "quality": "high",
  "fps": 30,
  
  "variables": {
    "word": "Example",
    "definition": "A thing characteristic of its kind or illustrating a general rule.",
    "image_url": "https://your-cdn.com/images/example.png",
    "channel_name": "@WhiteEnglishVocabulary"
  },
  
  "scenes": [
    {
      "comment": "Main Vocabulary Scene - 10 seconds",
      "duration": 10,
      "background-color": "#FFFFFF",
      
      "elements": [
        {
          "comment": "=== WORD TITLE ===",
          "comment2": "Y: 175-230px (55px height), Safe Area: 270-810px (540px width)",
          "type": "text",
          "text": "{{word}}",
          "style": "001",
          "position": "custom",
          "x": 270,
          "y": 175,
          "width": 540,
          "height": 55,
          "duration": 10,
          "start": 0,
          "settings": {
            "font-family": "Poppins",
            "font-size": "72px",
            "font-weight": "700",
            "color": "#232323",
            "text-align": "center",
            "vertical-position": "middle",
            "horizontal-position": "center"
          }
        },
        
        {
          "comment": "=== DEFINITION TEXT ===",
          "comment2": "Y: 230-305px (75px height), Safe Area: 270-810px (540px width)",
          "type": "text",
          "text": "{{definition}}",
          "style": "001",
          "position": "custom",
          "x": 270,
          "y": 230,
          "width": 540,
          "height": 75,
          "duration": 10,
          "start": 0,
          "settings": {
            "font-family": "Poppins",
            "font-size": "32px",
            "font-weight": "400",
            "color": "#3C3C3C",
            "text-align": "center",
            "vertical-position": "top",
            "horizontal-position": "center",
            "line-height": "1.35"
          }
        },
        
        {
          "comment": "=== ILLUSTRATION IMAGE ===",
          "comment2": "Y: 305-530px (225px height), Max Width: 750px, Centered",
          "type": "image",
          "src": "{{image_url}}",
          "position": "custom",
          "x": 165,
          "y": 305,
          "width": 750,
          "height": 225,
          "duration": 10,
          "start": 0
        },
        
        {
          "comment": "=== CHANNEL BRANDING ===",
          "comment2": "Y: 540-570px (30px height), Safe Area: 270-810px (540px width)",
          "type": "text",
          "text": "{{channel_name}}",
          "style": "001",
          "position": "custom",
          "x": 270,
          "y": 540,
          "width": 540,
          "height": 30,
          "duration": 10,
          "start": 0,
          "settings": {
            "font-family": "Poppins",
            "font-size": "28px",
            "font-weight": "500",
            "color": "#3C3C3C",
            "text-align": "center",
            "vertical-position": "middle",
            "horizontal-position": "center"
          }
        },
        
        {
          "comment": "=== AI VOICE NARRATION ===",
          "type": "voice",
          "text": "{{word}}. {{definition}}",
          "voice": "en-US-AriaNeural",
          "speed": 0.9,
          "start": 0.5,
          "duration": -1
        }
      ]
    }
  ]
}
